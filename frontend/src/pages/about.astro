---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

let seoTitle = "About | Huynh Hieu Travel";
let seoDescription = undefined;
let ogImage = undefined;

const db = Astro.locals.runtime?.env?.DB;
if (db) {
  try {
    const stmt = db.prepare('SELECT * FROM Page WHERE slug = ?');
    const pageData = await stmt.bind('about').first();
    if (pageData) {
      if (pageData.seoTitle) seoTitle = pageData.seoTitle;
      else if (pageData.title) seoTitle = `${pageData.title} | Huynh Hieu Travel`;
      if (pageData.seoDescription) seoDescription = pageData.seoDescription;
      if (pageData.featuredImage) ogImage = pageData.featuredImage;
    }
  } catch (e) {
    console.error("DB Error in about:", e);
  }
}
---

<Layout title={seoTitle} description={seoDescription} image={ogImage}>
  <Header />
  <main class="page-content" style="padding-top: 100px;">
    
    <!-- Hero Section -->
    <section class="section" style="padding-bottom: 60px;">
      <div class="container max-w-4xl">
        <h1 class="hero-title mb-5" style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; line-height: 1.2;">
          Đôi lời giới thiệu về tôi
        </h1>
        
        <div class="prose mb-5" style="font-size: 1.15rem; color: rgba(255, 255, 255, 0.85); line-height: 1.8;">
          <p class="mb-4">
            Tôi là Huynh Hieu, một người Thiết kế Website đa ngành, tập trung vào kể câu chuyện của thương hiệu. Tôi mang câu chuyện, đặc trưng của thương hiệu đến khách hàng của họ một cách trực quan. Giá trị làm việc của tôi là tối ưu trải nghiệm người dùng, kết nối nội dung và thông tin hữu ích. Tôi chuyên về việc định hướng lâu dài và phát triển với nền tảng vững chắc.
          </p>
          <p class="mb-5">
            Trong hơn 7 năm, tôi đã làm việc cùng các công ty vừa và nhỏ hay các công ty khởi nghiệp để mang đến định hướng rõ ràng, phát triển từ nền tảng vững chắc; với tư cách là người Thiết kế website và leader về nội dung marketing digital. Ngoài thời gian làm việc, tôi có sở thích về ngành du lịch (chắc chắn có liên quan đến cái tên thương hiệu của tôi) và tìm hiểu về các vấn đề Triết học.
          </p>
        </div>

        <div class="mb-5">
          <img src="/media/gioi-thieu-website-huynh-hieu-travel.jpg" alt="Huynh Hieu Travel Giới Thiệu" style="width: 100%; border-radius: 12px; object-fit: cover;" />
        </div>
      </div>
    </section>

    <!-- Services & Tools Section -->
    <section class="section border-top" style="padding-top: 80px; padding-bottom: 80px;">
      <div class="container max-w-4xl">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: 40px;">
          
          <!-- Services -->
          <div>
            <h2 class="section-heading" style="font-size: 1.5rem; margin-bottom: 20px;">Dịch vụ của tôi</h2>
            <ul class="styled-list" style="font-size: 1.1rem; color: rgba(255, 255, 255, 0.85);">
              <li>Thiết kế website</li>
              <li>SEO & SEM</li>
              <li>Phát triển nội dung website</li>
            </ul>
          </div>

          <!-- Tools -->
          <div>
            <h2 class="section-heading" style="font-size: 1.5rem; margin-bottom: 20px;">Công cụ website</h2>
            <ul class="styled-list" style="font-size: 1.1rem; color: rgba(255, 255, 255, 0.85);">
              <li>Elementor trên nền tảng WordPress</li>
              <li>Dynamic Data cho Website</li>
            </ul>
          </div>
          
        </div>
      </div>
    </section>

    <!-- Experience Section -->
    <section class="section border-top" style="padding-top: 80px; padding-bottom: 80px;">
      <div class="container max-w-4xl">
        <h2 class="section-heading mb-4" style="font-size: 2rem;">Hơn 7 năm kinh nghiệm</h2>
        <div class="prose mb-5" style="font-size: 1.15rem; color: rgba(255, 255, 255, 0.85); line-height: 1.8;">
          <p class="mb-4">
            Tôi may mắn khi có cơ hội làm việc với nhiều vị trí, từ công việc Marketing Digital ở các công ty hay freelancer thiết kế website và nội dung, tôi cũng may mắn cộng tác và phát triển thành công cùng các doanh nghiệp trong những năm gần đây.
          </p>
          <p class="mb-5">
            Tôi mang đến giải pháp cho các doanh nghiệp thiếu định hướng phát triển và hoạt động thiếu hiệu quả trong Marketing Digital.
          </p>
        </div>

        <!-- Stats Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 30px; margin-top: 40px;">
          
          <div style="text-align: left; padding: 30px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px;">
            <div style="font-size: 2.5rem; font-weight: 800; color: #fff; margin-bottom: 10px;">1,5 triệu</div>
            <div style="font-size: 1rem; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 1px;">View/năm</div>
          </div>
          
          <div style="text-align: left; padding: 30px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px;">
            <div style="font-size: 2.5rem; font-weight: 800; color: #fff; margin-bottom: 10px;">30+</div>
            <div style="font-size: 1rem; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 1px;">Website đã thiết kế</div>
          </div>

          <div style="text-align: left; padding: 30px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px;">
            <div style="font-size: 2.5rem; font-weight: 800; color: #fff; margin-bottom: 10px;">1.000+</div>
            <div style="font-size: 1rem; color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 1px;">Trang top đầu</div>
          </div>
          
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section class="section border-top" style="padding-top: 100px; padding-bottom: 150px;">
      <div class="container max-w-4xl text-center">
        <h2 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 900; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 40px; color: #fff;">
          Let's talk about the next big thing
        </h2>
        
        <div style="display: flex; gap: 20px; justify-content: center; flex-wrap: wrap;">
          <a href="https://www.facebook.com/huynhhieutravel/" target="_blank" rel="noopener noreferrer" class="social-btn">
            Facebook #huynhhieutravel
          </a>
          <a href="https://x.com/TravelHieu" target="_blank" rel="noopener noreferrer" class="social-btn">
            Twitter #huynhhieutravel
          </a>
          <a href="https://www.instagram.com/hieuhuynhtravel/" target="_blank" rel="noopener noreferrer" class="social-btn">
            Instagram #huynhhieutravel
          </a>
          <a href="mailto:huynhhieutravel@gmail.com" class="social-btn" style="background: #fff; color: #000; border-color: #fff;">
            huynhhieutravel@gmail.com
          </a>
        </div>
      </div>
    </section>

  </main>
  <Footer />
</Layout>

<style>
  .border-top {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  
  .social-btn {
    display: inline-block;
    padding: 12px 24px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 99px;
    color: #fff;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  
  .social-btn:hover {
    border-color: rgba(255, 255, 255, 0.8);
    background: rgba(255, 255, 255, 0.05);
  }
</style>
