---
import { env } from "cloudflare:workers";
import Layout from '../layouts/Layout.astro';

const { slug } = Astro.params;

// Access D1 from Cloudflare Workers env
const db = env.DB;

let post = null;

if (db) {
  try {
    const stmt = db.prepare('SELECT * FROM Post WHERE slug = ?');
    post = await stmt.bind(slug).first();
    
    if (!post) {
      const pageStmt = db.prepare('SELECT * FROM Page WHERE slug = ?');
      post = await pageStmt.bind(slug).first();
    }
  } catch (e) {
    console.error("DB Error:", e);
  }
} else {
  console.log("No DB binding found, you might be running in a mode without platformProxy.");
}

if (!post) {
  return Astro.redirect('/404');
}

---

<Layout 
  title={post.seoTitle || `${post.title} - Huỳnh Hiếu Travel`} 
  description={post.seoDescription || post.excerpt} 
  image={post.ogImage || post.featuredImage}
>
  <article class="elementor elementor-page">
    {post.css_content && <style set:html={post.css_content}></style>}
    <div class="elementor-container">
      <div set:html={post.content} />
    </div>
  </article>
</Layout>
