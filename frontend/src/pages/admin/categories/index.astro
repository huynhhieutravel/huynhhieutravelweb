---
import { env } from "cloudflare:workers";
import AdminLayout from '../../../layouts/AdminLayout.astro';
const d1Db = env.DB;
let categories: any[] = [];

if (d1Db) {
  try {
    // Note: The UI fetches its own data to render SSR
    const { results } = await d1Db.prepare(`
      SELECT c.*, p.name as parentName 
      FROM Category c
      LEFT JOIN Category p ON c.parentId = p.id
      ORDER BY c.name ASC
    `).all();

    const rawCats = results || [];
    const tree: any[] = [];
    const lookup = new Map();

    rawCats.forEach(c => lookup.set(c.id, { ...c, children: [] }));

    lookup.forEach(c => {
      if (c.parentId) {
        const parent = lookup.get(c.parentId);
        if (parent) {
          parent.children.push(c);
        } else {
          tree.push(c);
        }
      } else {
        tree.push(c);
      }
    });

    const flatList: any[] = [];
    function flatten(nodes: any[], depth = 0) {
      nodes.forEach(node => {
        flatList.push({ ...node, depth });
        if (node.children.length > 0) {
          flatten(node.children, depth + 1);
        }
      });
    }
    flatten(tree);
    categories = flatList;

  } catch (e) {
    console.error(e);
  }
}
---

<AdminLayout title="Categories" activeMenu="posts" activeSubmenu="categories">
<style>
  .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .header h2 { font-size: 24px; font-weight: 700; }
  
  .layout-grid { display: grid; grid-template-columns: 300px 1fr; gap: 24px; align-items: start; }
  @media (max-width: 768px) { .layout-grid { grid-template-columns: 1fr; } }
  
  .card { background: #fff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; }
  
  .form-group { margin-bottom: 16px; }
  .form-group label { display: block; font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 6px; }
  .form-group input, .form-group select, .form-group textarea { width: 100%; padding: 8px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 14px; outline: none; font-family: inherit; }
  .form-group input:focus, .form-group select:focus, .form-group textarea:focus { border-color: #2563eb; box-shadow: 0 0 0 2px #bfdbfe; }
  .form-group .hint { display: block; font-size: 12px; color: #64748b; margin-top: 4px; line-height: 1.4; }
  
  .btn-submit { background: #2563eb; color: #fff; font-weight: 600; padding: 8px 16px; border: none; border-radius: 6px; cursor: pointer; font-size: 13px; }
  .btn-submit:hover { background: #1d4ed8; }
  
  table { width: 100%; border-collapse: collapse; }
  thead th { text-align: left; padding: 12px 14px; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; color: #64748b; border-bottom: 1px solid #e2e8f0; background: #f8fafc; }
  tbody td { padding: 12px 14px; font-size: 13px; border-bottom: 1px solid #f1f5f9; }
  tbody tr:hover { background: #f8fafc; }
  
  .action-link { font-size: 12px; border: none; background: none; cursor: pointer; padding: 0; display: inline-block; margin-right: 8px; }
  .action-edit { color: #2563eb; }
  .action-delete { color: #ef4444; }

  .indent-dash { color: #cbd5e1; margin-right: 4px; }
</style>

<div class="header">
  <h2>Categories</h2>
</div>

<div class="layout-grid">
  <!-- Add New Form -->
  <div class="card">
    <h3 style="font-size: 16px; font-weight: 600; margin-bottom: 16px;">Add New Category</h3>
    <form id="addCatForm">
      <div class="form-group">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required />
        <span class="hint">The name is how it appears on your site.</span>
      </div>
      <div class="form-group">
        <label for="slug">Slug</label>
        <input type="text" id="slug" name="slug" />
        <span class="hint">The "slug" is the URL-friendly version of the name. It is usually all lowercase and contains only letters, numbers, and hyphens.</span>
      </div>
      <div class="form-group">
        <label for="parentId">Parent Category</label>
        <select id="parentId" name="parentId">
          <option value="">None</option>
          {categories.map(cat => (
            <option value={cat.id}>
              {Array(cat.depth).fill('—').join('')} {cat.name}
            </option>
          ))}
        </select>
        <span class="hint">Categories, unlike tags, can have a hierarchy. You might have a Jazz category, and under that have children categories for Bebop and Big Band.</span>
      </div>
      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="4"></textarea>
        <span class="hint">The description is not prominent by default; however, some themes may show it.</span>
      </div>
      <button type="submit" class="btn-submit">Add New Category</button>
    </form>
  </div>

  <!-- List Table -->
  <div class="card" style="padding: 0; overflow: hidden;">
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Description</th>
          <th>Slug</th>
          <th>Count</th>
          <th style="width: 100px;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {categories.length === 0 && (
          <tr><td colspan="5" style="text-align: center; color: #94a3b8; padding: 24px;">No categories found.</td></tr>
        )}
        {categories.map(cat => (
          <tr id={`row-${cat.id}`}>
            <td style="font-weight: 600;">
              {Array(cat.depth).fill(0).map(() => <span class="indent-dash">—</span>)}
              {cat.name}
            </td>
            <td style="color: #64748b; max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
              {cat.description || '—'}
            </td>
            <td style="color: #64748b;">{cat.slug}</td>
            <td>{cat.count}</td>
            <td>
              <button class="action-link action-edit" onclick={`editCat('${cat.id}', '${cat.name.replace(/'/g, "\\'")}', '${cat.slug}', '${cat.parentId || ''}', '${(cat.description || '').replace(/'/g, "\\'")}')`}>Edit</button>
              <button class="action-link action-delete" onclick={`deleteCat('${cat.id}')`}>Delete</button>
              <a href={`/${cat.slug}`} target="_blank" class="action-link action-view" style="color: #10b981; text-decoration: none;">View</a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<script is:inline>
  let editingId = null;

  document.getElementById('addCatForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = document.getElementById('name').value;
    const slug = document.getElementById('slug').value;
    const parentId = document.getElementById('parentId').value;
    const description = document.getElementById('description').value;
    
    const btn = e.target.querySelector('button');
    const originalText = btn.innerText;

    btn.innerText = 'Saving...';
    btn.disabled = true;

    try {
      const url = editingId ? `/api/admin/categories/${editingId}` : '/api/admin/categories';
      const method = editingId ? 'PUT' : 'POST';

      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, slug, parentId, description })
      });
      const resData = await res.json();

      if (res.ok && resData.success) {
        window.location.reload();
      } else {
        window.AppModal.alert(resData.error?.message || 'Lỗi khi lưu danh mục', 'error');
      }
    } catch (err) {
      window.AppModal.alert('Lỗi kết nối đến máy chủ', 'error');
    } finally {
      btn.innerText = originalText;
      btn.disabled = false;
    }
  });

  function editCat(id, name, slug, parentId, description) {
    editingId = id;
    document.getElementById('name').value = name;
    document.getElementById('slug').value = slug;
    document.getElementById('parentId').value = parentId;
    document.getElementById('description').value = description;
    
    document.querySelector('.btn-submit').innerText = 'Update Category';
    document.querySelector('.card h3').innerText = 'Edit Category';
    
    if (!document.getElementById('cancelEditBtn')) {
      const cancelBtn = document.createElement('button');
      cancelBtn.id = 'cancelEditBtn';
      cancelBtn.type = 'button';
      cancelBtn.innerText = 'Cancel';
      cancelBtn.style.marginLeft = '8px';
      cancelBtn.style.padding = '8px 16px';
      cancelBtn.style.background = '#f1f5f9';
      cancelBtn.style.border = '1px solid #cbd5e1';
      cancelBtn.style.borderRadius = '6px';
      cancelBtn.style.cursor = 'pointer';
      cancelBtn.onclick = () => {
        editingId = null;
        document.getElementById('addCatForm').reset();
        document.querySelector('.btn-submit').innerText = 'Add New Category';
        document.querySelector('.card h3').innerText = 'Add New Category';
        cancelBtn.remove();
      };
      document.querySelector('.btn-submit').after(cancelBtn);
    }
    
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  async function deleteCat(id) {
    const confirmed = await window.AppModal.confirm('Bạn có chắc muốn xóa danh mục này?');
    if (!confirmed) return;
    try {
      const res = await fetch(`/api/admin/categories/${id}`, { method: 'DELETE' });
      const resData = await res.json();
      if (res.ok && resData.success) {
        window.location.reload();
      } else {
        window.AppModal.alert(resData.error?.message || 'Lỗi khi xóa', 'error');
      }
    } catch (err) {
      window.AppModal.alert('Lỗi kết nối đến máy chủ', 'error');
    }
  }
</script>
</AdminLayout>
