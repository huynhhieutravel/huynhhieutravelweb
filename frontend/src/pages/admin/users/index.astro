---
import { env } from "cloudflare:workers";
import AdminLayout from '../../../layouts/AdminLayout.astro';

const { locals } = Astro;
const authorize = (locals as any).authorize;

if (!authorize('view', 'user')) {
  return Astro.redirect('/admin');
}

const d1Db = env.DB;
let users = [];

if (d1Db) {
  const { results } = await d1Db.prepare("SELECT id, username, email, role, is_active, failed_login_attempts, created_at, last_login_at FROM User ORDER BY created_at DESC").all();
  if (results) users = results;
}
---

<AdminLayout title="Quản lý tài khoản" activeMenu="system" activeSubmenu="users">
  <div class="header-actions" style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 24px;">
    <div>
      <h2 style="font-size: 24px; font-weight: 700; color: #0f172a; margin-bottom: 4px;">Users & Roles</h2>
      <p style="color: #64748b; font-size: 14px;">Quản lý tài khoản và phân quyền truy cập hệ thống.</p>
    </div>
    {authorize('create', 'user') && (
      <a href="/admin/users/new" style="background:#0f172a; color:#fff; text-decoration:none; display:inline-block; padding:10px 16px; border-radius:8px; font-size:14px; font-weight:600;">
        + Thêm User
      </a>
    )}
  </div>

  <div class="card" style="padding: 0; overflow: hidden;">
    <table style="width: 100%; border-collapse: collapse; text-align: left;">
      <thead style="background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
        <tr>
          <th style="padding: 16px; font-size: 13px; font-weight: 600; color: #475569;">Tài khoản</th>
          <th style="padding: 16px; font-size: 13px; font-weight: 600; color: #475569;">Vai trò (Role)</th>
          <th style="padding: 16px; font-size: 13px; font-weight: 600; color: #475569;">Trạng thái</th>
          <th style="padding: 16px; font-size: 13px; font-weight: 600; color: #475569;">Lần đăng nhập cuối</th>
          <th style="padding: 16px; font-size: 13px; font-weight: 600; color: #475569; text-align:right;">Hành động</th>
        </tr>
      </thead>
      <tbody>
        {users.length === 0 ? (
          <tr><td colspan="5" style="padding:24px; text-align:center; color:#64748b;">Không có dữ liệu</td></tr>
        ) : users.map((u: any) => (
          <tr style="border-bottom: 1px solid #e2e8f0;">
            <td style="padding: 16px;">
              <div style="font-weight: 600; color: #0f172a;">{u.username}</div>
              <div style="font-size: 13px; color: #64748b;">{u.email}</div>
            </td>
            <td style="padding: 16px;">
              <span class={`badge ${u.role === 'admin' ? 'badge-published' : u.role === 'editor' ? 'badge-pending' : 'badge-draft'}`}>
                {u.role.toUpperCase()}
              </span>
            </td>
            <td style="padding: 16px;">
              {u.is_active ? (
                <span style="color:#16a34a; font-weight:600; font-size:13px;">● Hoạt động</span>
              ) : (
                <span style="color:#ef4444; font-weight:600; font-size:13px;">● Đã khoá</span>
              )}
              {u.failed_login_attempts >= 5 && (
                <div style="font-size:11px; color:#ef4444; margin-top:4px;">Bị khoá tạm (Login failed)</div>
              )}
            </td>
            <td style="padding: 16px; font-size: 13px; color: #475569;">
              {u.last_login_at ? new Date(u.last_login_at).toLocaleString('vi-VN') : 'Chưa từng đăng nhập'}
            </td>
            <td style="padding: 16px; text-align:right;">
              {authorize('edit', 'user') && (
                <a href={`/admin/users/${u.id}`} style="background:none; border:none; color:#3b82f6; text-decoration:none; font-size:13px; font-weight:600; cursor:pointer; margin-right:8px;">Sửa</a>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</AdminLayout>
