---
// Header.astro
---

<header class="header">
  <div class="container header-container">
    <a href="/" class="logo">
      <img src="/media/huynhhieutravel-white-logo.png" alt="Huỳnh Hiếu Travel" class="logo-img" />
    </a>
    
    <!-- Animated Apple-style Hamburger -->
    <button class="menu-toggle" id="menuToggle" aria-label="Toggle Menu">
      <div class="hamburger">
        <span></span>
        <span></span>
      </div>
    </button>
  </div>
</header>

<!-- Full-screen Glassmorphism Overlay -->
<nav class="menu-overlay" id="menuOverlay">
  <div class="container menu-overlay-content">
    <ul class="nav-links">
      <li><a href="/" class="nav-link">Trang Chủ</a></li>
      <li><a href="/fme-ecosystem-project" class="nav-link">FME Ecosystem</a></li>
      <li><a href="/about" class="nav-link">Về Tôi</a></li>
      <li><a href="/lien-he" class="nav-link">Liên Hệ</a></li>
    </ul>
    
    <div class="menu-socials">
      <p>Kết nối</p>
      <div class="social-links-row">
        <a href="https://www.facebook.com/huynhhieutravel/" target="_blank" rel="noopener noreferrer">Facebook</a>
        <a href="https://x.com/TravelHieu" target="_blank" rel="noopener noreferrer">Twitter</a>
        <a href="https://www.instagram.com/hieuhuynhtravel/" target="_blank" rel="noopener noreferrer">Instagram</a>
      </div>
    </div>
  </div>
</nav>

<style is:global>
  /* Header Container */
  .header {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000; /* Ensure it stays above the overlay */
    padding: 32px 0;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    z-index: 1001; /* Keep logo clickable above overlay */
  }

  .logo-img {
    height: 48px;
    width: auto;
    object-fit: contain;
  }

  /* Animated Hamburger Button */
  .menu-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 1001; /* Keep button clickable above overlay */
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hamburger {
    width: 24px;
    height: 18px;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  /* Apple Style uses 2 lines that turn into an X */
  .hamburger span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: #fff;
    border-radius: 2px;
    transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1), 
                opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                top 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    position: absolute;
    left: 0;
  }

  .hamburger span:nth-child(1) {
    top: 0;
  }

  .hamburger span:nth-child(2) {
    top: 16px;
  }

  /* Active state (X) */
  .menu-toggle.is-active .hamburger span:nth-child(1) {
    top: 8px;
    transform: rotate(45deg);
  }

  .menu-toggle.is-active .hamburger span:nth-child(2) {
    top: 8px;
    transform: rotate(-45deg);
  }

  /* Full Screen Overlay */
  .menu-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(25px); /* Glassmorphism */
    -webkit-backdrop-filter: blur(25px);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1), visibility 0.5s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .menu-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .menu-overlay-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start; /* Align left for modern look */
    width: 100%;
    max-width: 800px; /* Constrain width on large screens */
  }

  /* Nav Links */
  .nav-links {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
  }

  .nav-links li {
    margin-bottom: 24px;
    overflow: hidden; /* For slide up animation */
  }

  .nav-link {
    display: inline-block;
    color: #fff;
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 700;
    text-decoration: none;
    letter-spacing: -1px;
    transform: translateY(100%);
    opacity: 0;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.6s ease,
                color 0.3s ease;
  }

  /* Staggered slide up animation */
  .menu-overlay.is-open .nav-links li:nth-child(1) .nav-link { transition-delay: 0.1s; transform: translateY(0); opacity: 1; }
  .menu-overlay.is-open .nav-links li:nth-child(2) .nav-link { transition-delay: 0.2s; transform: translateY(0); opacity: 1; }
  .menu-overlay.is-open .nav-links li:nth-child(3) .nav-link { transition-delay: 0.3s; transform: translateY(0); opacity: 1; }
  .menu-overlay.is-open .nav-links li:nth-child(4) .nav-link { transition-delay: 0.4s; transform: translateY(0); opacity: 1; }

  /* Hover dimming effect on sibling links */
  .nav-links:hover .nav-link {
    opacity: 0.3;
  }
  .nav-links .nav-link:hover {
    opacity: 1;
  }

  /* Socials inside menu */
  .menu-socials {
    margin-top: 60px;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .menu-overlay.is-open .menu-socials {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.5s;
  }

  .menu-socials p {
    color: rgba(255, 255, 255, 0.5);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }

  .social-links-row {
    display: flex;
    gap: 24px;
  }

  .social-links-row a {
    color: #fff;
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .social-links-row a:hover {
    color: rgba(255,255,255,0.6);
  }

  /* Lock scroll when menu is open */
  body.menu-open {
    overflow: hidden;
  }
</style>


<script>
  // Script runs on client side after component mounts
  function setupMenu() {
    const menuToggle = document.getElementById('menuToggle');
    const menuOverlay = document.getElementById('menuOverlay');
    const body = document.body;

    if (menuToggle && menuOverlay) {
      // Remove old listeners if re-running (Astro view transitions)
      const newMenuToggle = menuToggle.cloneNode(true);
      menuToggle.parentNode?.replaceChild(newMenuToggle, menuToggle);

      newMenuToggle.addEventListener('click', () => {
        const isOpen = newMenuToggle.classList.contains('is-active');
        
        if (isOpen) {
          // Close menu
          newMenuToggle.classList.remove('is-active');
          menuOverlay.classList.remove('is-open');
          body.classList.remove('menu-open');
        } else {
          // Open menu
          newMenuToggle.classList.add('is-active');
          menuOverlay.classList.add('is-open');
          body.classList.add('menu-open');
        }
      });
    }
  }

  // Run on initial load
  setupMenu();

  // Support Astro View Transitions if enabled
  document.addEventListener('astro:page-load', setupMenu);
</script>
